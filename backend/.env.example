OPENAI_API_KEY=sk-proj_replace_me
APP_CLIENT_TOKEN=replace_with_a_long_random_secret
CLAUDE_API_KEY=replace_with_an_anthropic_console_api_key
CLAUDE_MODEL=claude-sonnet-5-5
# Required for an Anthropic API key that is not scoped to a workspace:
# ANTHROPIC_WORKSPACE_ID=wrkspc_replace_me
FALAI_API_KEY=replace_with_a_fal_api_key
# Standard aliases ANTHROPIC_API_KEY and FAL_KEY are also supported.
# Optional persistent Render disk for finished Claude results (24h retention):
# CLAUDE_JOB_DIR=/var/data/claude-jobs
PORT=8787
TRANSCRIPTION_MODEL=gpt-4o-transcribe
REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
SUMMARY_MODEL=gpt-4.1-mini
DEFAULT_LANGUAGE=fr
# Optionnel : n'active la verification des tokens Supabase (Ultimate Audio
# Recorder) que si ces deux variables sont definies. Sans elles, seuls les
# tokens Firebase (CollabManga/Manga Forge) et x-app-token continuent de
# fonctionner comme avant.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
MANGA_FORGE_ENABLED=true
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1536
IMAGE_QUALITY=high
IMAGE_FORMAT=png
CREDIT_COST_MANGA_PAGE=10
