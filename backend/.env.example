OPENAI_API_KEY=sk-proj_replace_me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
# Utilise uniquement par scripts/create-play-subscriptions.js (jamais lu par
# le serveur en production). Cle de compte de service Play Console — voir
# docs/google_play_billing.md.
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=./google-play-service-account.json
# Sur Render, utiliser plutot un secret contenant le JSON complet sur une ligne.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account"}
# Authentification OIDC de la souscription Push Pub/Sub utilisee par RTDN.
# L'audience doit etre exactement celle configuree dans la souscription.
GOOGLE_PUBSUB_PUSH_AUDIENCE=https://pulsenote.onrender.com/billing/google-play/rtdn
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=play-rtdn-push@your-project.iam.gserviceaccount.com
PORT=8787
TRANSCRIPTION_MODEL=gpt-4o-transcribe
REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
SUMMARY_MODEL=gpt-4.1-mini
DEFAULT_LANGUAGE=fr
